        "\n",
        "\n",
        "# ----------------------------------------------------------------------\n",
        "# 9. FEATURE SCALING\n",
        "# ----------------------------------------------------------------------\n",
        "def scale_features(\n",
        "    X_train: pd.DataFrame,\n",
        "    X_test: pd.DataFrame,\n",
        "    numerical_cols: list = None,\n",
        "):\n",
        "    \"\"\"\n",
        "    Standardize continuous numerical features (zero mean, unit variance).\n",
        "\n",
        "    Only applied to genuinely continuous columns (age, height, weight,\n",
        "    ap_hi, ap_lo). Binary columns (gender, smoke, alco, active) and\n",
        "    ordinal columns (cholesterol, gluc) are intentionally left unscaled,\n",
        "    since scaling 0/1/2/3 values doesn't help these models and makes the\n",
        "    values harder to interpret.\n",
        "\n",
        "    Critically, the scaler is FIT ONLY ON THE TRAINING SET, then used to\n",
        "    transform both train and test. Fitting on the full dataset (including\n",
        "    test data) would leak information about the test set's distribution\n",
        "    into training -- a common and subtle mistake.\n",
        "    \"\"\"\n",
        "    if numerical_cols is None:\n",
        "        numerical_cols = [\"age\", \"height\", \"weight\", \"ap_hi\", \"ap_lo\"]\n",
        "    numerical_cols = [c for c in numerical_cols if c in X_train.columns]\n",
        "\n",
        "    scaler = StandardScaler()\n",
        "    X_train_scaled = X_train.copy()\n",
        "    X_test_scaled = X_test.copy()\n",
        "\n",
        "    X_train_scaled[numerical_cols] = scaler.fit_transform(X_train[numerical_cols])\n",
        "    X_test_scaled[numerical_cols] = scaler.transform(X_test[numerical_cols])\n",
        "\n",
        "    print(f\"[scaling] Standardized columns: {numerical_cols} \"\n",
        "          f\"(fit on train only).\")\n",
        "    return X_train_scaled, X_test_scaled, scaler\n",
        "\n"
      ],
      "metadata": {
        "id": "YOexWyoAJ8iC"
      },
