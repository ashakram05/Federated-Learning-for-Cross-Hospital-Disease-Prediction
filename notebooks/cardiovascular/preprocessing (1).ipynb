        "\n",
        "# ----------------------------------------------------------------------\n",
        "# 8. TRAIN-TEST SPLIT\n",
        "# ----------------------------------------------------------------------\n",
        "def split_data(\n",
        "    df: pd.DataFrame,\n",
        "    target_col: str = \"cardio\",\n",
        "    test_size: float = 0.2,\n",
        "    random_state: int = 42,\n",
        "):\n",
        "    \"\"\"\n",
        "    Split the data into train and test sets, stratified by the target.\n",
        "\n",
        "    Stratification guarantees the ~50/50 class balance (confirmed in EDA)\n",
        "    is preserved identically in both the train and test sets, removing\n",
        "    any risk of an unlucky split skewing the class ratio.\n",
        "\n",
        "    This split happens BEFORE any later hospital/client partitioning for\n",
        "    Federated Learning -- the test set here acts as a held-out global\n",
        "    test set for evaluating the aggregated global model, independent of\n",
        "    however training data later gets divided across simulated hospitals.\n",
        "    \"\"\"\n",
        "    X = df.drop(columns=[target_col])\n",
        "    y = df[target_col]\n",
        "\n",
        "    X_train, X_test, y_train, y_test = train_test_split(\n",
        "        X, y,\n",
        "        test_size=test_size,\n",
        "        random_state=random_state,\n",
        "        stratify=y,\n",
        "    )\n",
        "    print(f\"[split] Train: {X_train.shape[0]} rows, \"\n",
        "          f\"Test: {X_test.shape[0]} rows \"\n",
        "          f\"(stratified on '{target_col}').\")\n",
        "    return X_train, X_test, y_train, y_test\n",
        "\n"
      ],
