        "\n",
        "# ----------------------------------------------------------------------\n",
        "# 4. OUTLIER HANDLING (domain-based, not statistical IQR)\n",
        "# ----------------------------------------------------------------------\n",
        "def clean_outliers(\n",
        "    df: pd.DataFrame,\n",
        "    ap_hi_range: tuple = (70, 250),\n",
        "    ap_lo_range: tuple = (40, 200),\n",
        "    height_range: tuple = (100, 220),\n",
        "    weight_range: tuple = (30, 200),\n",
        ") -> pd.DataFrame:\n",
        "    \"\"\"\n",
        "    Remove rows with medically implausible values.\n",
        "\n",
        "    Rationale (from EDA): ap_hi/ap_lo contained impossible values such as\n",
        "    negative blood pressure and readings above 10,000, plus 1,234 rows\n",
        "    where ap_hi < ap_lo (systolic below diastolic, which is physiologically\n",
        "    invalid). These are treated as data-entry errors, not real patients.\n",
        "\n",
        "    We use domain-based bounds (real-world plausible ranges) rather than\n",
        "    the statistical IQR method, because IQR would also discard genuinely\n",
        "    high-but-real blood pressure readings from hypertensive patients --\n",
        "    exactly the patients most relevant to predicting cardiovascular\n",
        "    disease. Rows are dropped (not capped), since capping would stack many\n",
        "    different error values onto the same boundary and create an artificial\n",
        "    spike in the distribution.\n",
        "\n",
        "    Default bounds are passed as arguments so they can be tuned without\n",
        "    editing the function body -- keeps the pipeline reusable.\n",
        "    \"\"\"\n",
        "    before = len(df)\n",
        "\n",
        "    valid = (\n",
        "        (df[\"ap_hi\"] >= ap_hi_range[0]) & (df[\"ap_hi\"] <= ap_hi_range[1]) &\n",
        "        (df[\"ap_lo\"] >= ap_lo_range[0]) & (df[\"ap_lo\"] <= ap_lo_range[1]) &\n",
        "        (df[\"ap_hi\"] >= df[\"ap_lo\"]) &  # systolic must be >= diastolic\n",
        "        (df[\"height\"] >= height_range[0]) & (df[\"height\"] <= height_range[1]) &\n",
        "        (df[\"weight\"] >= weight_range[0]) & (df[\"weight\"] <= weight_range[1])\n",
        "    )\n",
        "\n",
        "    df_clean = df[valid].reset_index(drop=True)\n",
        "    after = len(df_clean)\n",
        "    print(f\"[outliers] Removed {before - after} rows with implausible \"\n",
        "          f\"blood pressure / height / weight values ({before} -> {after}).\")\n",
        "    return df_clean\n",
        "\n"
      ],
      "metadata": {
        "id": "XiWIHjGXJecl"
      },
      "execution_count": 9,
