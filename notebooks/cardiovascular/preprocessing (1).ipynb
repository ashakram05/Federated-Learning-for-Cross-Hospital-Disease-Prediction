        "# ----------------------------------------------------------------------\n",
        "# 6. ENCODING CATEGORICAL VARIABLES\n",
        "# ----------------------------------------------------------------------\n",
        "def encode_categorical(df: pd.DataFrame) -> pd.DataFrame:\n",
        "    \"\"\"\n",
        "    Encode categorical variables appropriately.\n",
        "\n",
        "    - gender: nominal, originally coded 1 (female) / 2 (male). Remapped to\n",
        "      0/1 for consistency with the other binary columns (smoke, alco,\n",
        "      active, cardio). No true ordering exists between genders, but since\n",
        "      there are only two categories, a 0/1 remap is equivalent to one-hot\n",
        "      encoding here (no information is lost).\n",
        "\n",
        "    - cholesterol, gluc: ordinal, coded 1 (normal) / 2 (above normal) /\n",
        "      3 (well above normal). These are left as raw integers because the\n",
        "      Kaggle encoding already respects the true medical ordering.\n",
        "      One-hot encoding these would discard that ordering and is\n",
        "      intentionally avoided.\n",
        "\n",
        "    - smoke, alco, active, cardio: already binary 0/1, no change needed.\n",
        "    \"\"\"\n",
        "    df = df.copy()\n",
        "    if \"gender\" in df.columns:\n",
        "        # Original: 1 = female, 2 = male -> remap to 0 = female, 1 = male\n",
        "        df[\"gender\"] = df[\"gender\"].map({1: 0, 2: 1})\n",
        "        print(\"[encoding] Gender column remapped to 0/1.\")\n",
        "    return df\n"
      ],
