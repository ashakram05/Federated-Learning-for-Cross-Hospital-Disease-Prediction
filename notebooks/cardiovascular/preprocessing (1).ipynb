      "source": [
        "\"\"\"\n",
        "Exploratory Data Analysis (EDA)\n",
        "Project: Federated Learning for Cross-Hospital Disease Prediction\n",
        "Dataset: Cardiovascular Disease Dataset (cardio_train.csv)\n",
        "\n",
        "This script performs ONLY exploratory analysis. No cleaning, no imputation,\n",
        "no outlier removal, and no feature engineering is applied — the goal here\n",
        "is purely to understand the data before deciding what preprocessing steps\n",
        "are needed later (and, per project scope, no hospital/client splitting\n",
        "happens at this stage either).\n",
        "\n",
        "Output: all figures are saved to the `eda_outputs/` folder as PNG files,\n",
        "and a text summary is printed to the console.\n",
        "\"\"\"\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import os\n",
        "\n",
        "# ------------------------------------------------------------------\n",
        "# 0. Setup\n",
        "# ------------------------------------------------------------------\n",
        "sns.set_style(\"whitegrid\")\n",
        "plt.rcParams[\"figure.dpi\"] = 110\n",
        "\n",
        "OUT_DIR = \"eda_outputs\"\n",
        "os.makedirs(OUT_DIR, exist_ok=True)\n",
        "\n",
        "\n",
        "# The Kaggle file is ';'-separated, not comma-separated\n",
        "df = pd.read_csv(file_path, sep=\";\")\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"1. DATASET SHAPE\")\n",
        "print(\"=\" * 70)\n",
        "print(f\"Rows: {df.shape[0]}, Columns: {df.shape[1]}\")\n",
        "\n",
        "# ------------------------------------------------------------------\n",
        "# 2. Data types\n",
        "# ------------------------------------------------------------------\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"2. DATA TYPES\")\n",
        "print(\"=\" * 70)\n",
        "print(df.dtypes)\n",
        "\n",
        "# ------------------------------------------------------------------\n",
        "# 3. Summary statistics\n",
        "# ------------------------------------------------------------------\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"3. SUMMARY STATISTICS\")\n",
        "print(\"=\" * 70)\n",
        "print(df.describe().T)\n",
        "\n",
        "# ------------------------------------------------------------------\n",
        "# 4. Missing values\n",
        "# ------------------------------------------------------------------\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"4. MISSING VALUES\")\n",
        "print(\"=\" * 70)\n",
        "missing = df.isnull().sum()\n",
        "print(missing)\n",
        "print(f\"\\nTotal missing cells: {missing.sum()}\")\n",
        "\n",
        "# ------------------------------------------------------------------\n",
        "# 5. Duplicate analysis\n",
        "# ------------------------------------------------------------------\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"5. DUPLICATE ANALYSIS\")\n",
        "print(\"=\" * 70)\n",
        "dupes_with_id = df.duplicated().sum()\n",
        "dupes_without_id = df.drop(columns=[\"id\"]).duplicated().sum() if \"id\" in df.columns else df.duplicated().sum()\n",
        "print(f\"Exact duplicate rows (including 'id'):     {dupes_with_id}\")\n",
        "print(f\"Duplicate rows ignoring 'id' column:        {dupes_without_id}\")\n",
        "\n",
        "# ------------------------------------------------------------------\n",
        "# 6. Class imbalance (target variable)\n",
        "# ------------------------------------------------------------------\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"6. CLASS BALANCE - target = 'cardio'\")\n",
        "print(\"=\" * 70)\n",
        "print(df[\"cardio\"].value_counts())\n",
        "print(df[\"cardio\"].value_counts(normalize=True) * 100)\n",
        "\n",
        "plt.figure(figsize=(5, 4))\n",
        "ax = sns.countplot(x=\"cardio\", data=df, hue=\"cardio\", palette=[\"#4C72B0\", \"#DD8452\"], legend=False)\n",
        "ax.set_title(\"Class Distribution: cardio (target)\")\n",
        "ax.set_xlabel(\"cardio (0 = No disease, 1 = Disease)\")\n",
        "ax.set_ylabel(\"Count\")\n",
        "for p in ax.patches:\n",
        "    ax.annotate(f\"{int(p.get_height())}\", (p.get_x() + p.get_width() / 2, p.get_height()),\n",
        "                ha=\"center\", va=\"bottom\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(f\"{OUT_DIR}/01_class_balance.png\")\n",
        "plt.close()\n",
        "\n",
        "# ------------------------------------------------------------------\n",
        "# 7. Feature engineering ONLY for visualization convenience\n",
        "#    (age in years is created as a temporary plotting column;\n",
        "#    it is NOT saved back to the dataset / not a preprocessing step)\n",
        "# ------------------------------------------------------------------\n",
        "df_plot = df.copy()\n",
        "df_plot[\"age_years\"] = df_plot[\"age\"] / 365.25\n",
        "\n",
        "# ------------------------------------------------------------------\n",
        "# 8. Histograms - numerical feature distributions\n",
        "# ------------------------------------------------------------------\n",
        "num_cols = [\"age_years\", \"height\", \"weight\", \"ap_hi\", \"ap_lo\"]\n",
        "\n",
        "fig, axes = plt.subplots(2, 3, figsize=(16, 9))\n",
        "axes = axes.flatten()\n",
        "for i, col in enumerate(num_cols):\n",
        "    sns.histplot(df_plot[col], bins=50, kde=True, ax=axes[i], color=\"#4C72B0\")\n",
        "    axes[i].set_title(f\"Distribution of {col}\")\n",
        "axes[-1].axis(\"off\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(f\"{OUT_DIR}/02_histograms_numerical.png\")\n",
        "plt.close()\n",
        "\n",
