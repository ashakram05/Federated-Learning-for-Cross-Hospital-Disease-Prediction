        "def handle_missing_values(df: pd.DataFrame) -> pd.DataFrame:\n",
        "    \"\"\"Check for missing values and handle them if present.\"\"\"\n",
        "    missing_counts = df.isnull().sum()\n",
        "    total_missing = missing_counts.sum()\n",
        "\n",
        "    if total_missing == 0:\n",
        "        print(\"[missing_values] No missing values found. Nothing to do.\")\n",
        "        return df\n",
        "\n",
        "    print(f\"[missing_values] Found {total_missing} missing cells. Imputing...\")\n",
        "    numerical_cols = [\"age\", \"height\", \"weight\", \"ap_hi\", \"ap_lo\"]\n",
        "    categorical_cols = [\"gender\", \"cholesterol\", \"gluc\", \"smoke\", \"alco\", \"active\"]\n",
        "\n",
        "    for col in numerical_cols:\n",
        "        if col in df.columns and df[col].isnull().any():\n",
        "            df[col] = df[col].fillna(df[col].median())\n",
        "\n",
        "    for col in categorical_cols:\n",
        "        if col in df.columns and df[col].isnull().any():\n",
        "            df[col] = df[col].fillna(df[col].mode()[0])\n",
        "\n",
        "    return df\n",
        "\n",
        "df = handle_missing_values(df)\n"
      ],
