        "def remove_duplicates(df: pd.DataFrame) -> pd.DataFrame:\n",
        "    \"\"\"Remove duplicate patient records (ignoring the 'id' column).\"\"\"\n",
        "    before = len(df)\n",
        "    id_col = [\"id\"] if \"id\" in df.columns else []\n",
        "    df = df.drop_duplicates(subset=[c for c in df.columns if c not in id_col])\n",
        "    after = len(df)\n",
        "    print(f\"[duplicates] Removed {before - after} duplicate rows ({before} -> {after}).\")\n",
        "    return df.reset_index(drop=True)\n",
        "\n"
