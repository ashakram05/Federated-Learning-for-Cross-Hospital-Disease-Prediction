      "source": [
        "\n",
        "# ----------------------------------------------------------------------\n",
        "# 10. SAVE PROCESSED DATA\n",
        "# ----------------------------------------------------------------------\n",
        "def save_processed_data(\n",
        "    X_train: pd.DataFrame,\n",
        "    X_test: pd.DataFrame,\n",
        "    y_train: pd.Series,\n",
        "    y_test: pd.Series,\n",
        "    output_dir: str = \".\",\n",
        "):\n",
        "    \"\"\"\n",
        "    Save the processed train/test sets to disk as CSV files.\n",
        "\n",
        "    Features and target are saved back together per split (train / test)\n",
        "    so each file is a complete, ready-to-use dataset -- this is the most\n",
        "    convenient format for loading directly into a model training script.\n",
        "    \"\"\"\n",
        "    train_df = X_train.copy()\n",
        "    train_df[\"cardio\"] = y_train.values\n",
        "    test_df = X_test.copy()\n",
        "    test_df[\"cardio\"] = y_test.values\n",
        "\n",
        "    train_path = f\"{output_dir}/cardio_train_processed.csv\"\n",
        "    test_path = f\"{output_dir}/cardio_test_processed.csv\"\n",
        "\n",
        "    train_df.to_csv(train_path, index=False)\n",
        "    test_df.to_csv(test_path, index=False)\n",
        "\n",
        "    print(f\"[save] Saved processed training set -> {train_path} \"\n",
        "          f\"({train_df.shape[0]} rows)\")\n",
        "    print(f\"[save] Saved processed test set -> {test_path} \"\n",
        "          f\"({test_df.shape[0]} rows)\")\n",
        "    return train_path, test_path\n",
        "\n"
      ],
